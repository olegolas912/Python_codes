   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import math\n",
    "\n",
    "# 1. Файлы\n",
    "temp_csv = 'C:/Users/Oleg/Desktop/temperature_filtered.csv'\n",
    "xlsx_map = 'C:/Users/Oleg/Desktop/olegy_хелп.xlsx'\n",
    "\n",
    "# 2. Данные по температуре\n",
    "df_t = (\n",
    "    pd.read_csv(temp_csv, dtype={'station_id': str})\n",
    "      .assign(year=lambda d: d['year'].astype(int))\n",
    ")\n",
    "\n",
    "# 3. Карта «станция → область»\n",
    "map_df = pd.read_excel(\n",
    "    xlsx_map,\n",
    "    sheet_name=0,\n",
    "    usecols=['Индекс', 'Область'],\n",
    "    dtype=str\n",
    ")\n",
    "map_df.columns = ['station_id', 'region']\n",
    "\n",
    "# 4. Фильтрация\n",
    "df = (\n",
    "    df_t.merge(map_df, on='station_id', how='left')\n",
    "        .dropna(subset=['region'])\n",
    ")\n",
    "df = df[(df['region'] != 'Волгоградская область') & (df['year'] >= 1980)]\n",
    "\n",
    "# 5. Усреднение по областям\n",
    "by_region = (\n",
    "    df.groupby(['region', 'year'], as_index=False)\n",
    "      .agg(region_mean_temp=('mean_year_temp', 'mean'))\n",
    ")\n",
    "\n",
    "# 6. Рисуем график\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "handles = []\n",
    "labels  = []\n",
    "\n",
    "for n, (region, grp) in enumerate(by_region.groupby('region'), start=1):\n",
    "    h, = ax.plot(\n",
    "        grp['year'],\n",
    "        grp['region_mean_temp'],\n",
    "        linewidth=1.5,\n",
    "        label=str(n)\n",
    "    )\n",
    "    handles.append(h)\n",
    "    labels.append(str(n))\n",
    "\n",
    "# линия тренда по всем регионам\n",
    "x = by_region['year']\n",
    "y = by_region['region_mean_temp']\n",
    "k, b = np.polyfit(x, y, 1)\n",
    "h_trend, = ax.plot(\n",
    "    x,\n",
    "    k * x + b,\n",
    "    '--',\n",
    "    color='black',\n",
    "    linewidth=3,\n",
    "    label='Средняя по всем регионам'\n",
    ")\n",
    "handles.append(h_trend)\n",
    "labels.append('')\n",
    "\n",
    "# подписи осей и заголовок\n",
    "ax.set_xlabel('Год')\n",
    "ax.set_ylabel('Средняя температура, °C')\n",
    "ax.set_title('Средняя температура по регионам')\n",
    "\n",
    "# 7. Перестройка порядка для легенды\n",
    "# Отделяем линии регионов от линии средней\n",
    "handles_regions = handles[:-1]\n",
    "labels_regions  = labels[:-1]\n",
    "\n",
    "# сортируем регионы по номеру\n",
    "pairs = sorted(zip(labels_regions, handles_regions), key=lambda x: int(x[0]))\n",
    "labels_sorted   = [lab for lab, _ in pairs]\n",
    "handles_sorted  = [h   for _,   h in pairs]\n",
    "\n",
    "# добавляем среднюю строку в конец\n",
    "labels_sorted.append(labels[-1])\n",
    "handles_sorted.append(handles[-1])\n",
    "\n",
    "# число колонок в легенде\n",
    "ncol = 3\n",
    "n_items = len(handles_sorted)\n",
    "nrow = math.ceil(n_items / ncol)\n",
    "\n",
    "# собираем порядок column-first, чтобы при ncol=3 получился визуально row-first\n",
    "handles_legend = []\n",
    "labels_legend  = []\n",
    "for col in range(ncol):\n",
    "    for row in range(nrow):\n",
    "        idx = row * ncol + col\n",
    "        if idx < n_items:\n",
    "            handles_legend.append(handles_sorted[idx])\n",
    "            labels_legend.append(labels_sorted[idx])\n",
    "\n",
    "# 8. Вывод легенды\n",
    "fig.subplots_adjust(bottom=0.15)\n",
    "fig.legend(\n",
    "    handles_legend, labels_legend,\n",
    "    loc='upper center',\n",
    "    bbox_to_anchor=(0.5, -0.08),\n",
    "    ncol=ncol,\n",
    "    fontsize='small',\n",
    "    frameon=False\n",
    ")\n",
    "\n",
    "plt.show()\n"
   ]
  },
