    "# ...existing code...\n",
    "handles = []      # will collect legend entries here\n",
    "labels  = []\n",
    "\n",
    "for n, (region, grp) in enumerate(by_region.groupby('region'), start=1):\n",
    "    h, = ax.plot(grp['year'],\n",
    "                  grp['region_mean_temp'],\n",
    "                  linewidth=1.5,\n",
    "                  label=f'{n}')   # легенда только с номером\n",
    "    handles.append(h)\n",
    "    labels.append(f'{n}')  # легенда только с номером\n",
    "\n",
    "# общая линия тренда по всем областям (не нумеруем)\n",
    "x = by_region['year']\n",
    "y = by_region['region_mean_temp']\n",
    "k, b = np.polyfit(x, y, 1)\n",
    "h_trend, = ax.plot(x,\n",
    "                   k * x + b,\n",
    "                   '--',\n",
    "                   color='black',\n",
    "                   linewidth=3,\n",
    "                   label='Средняя по всем регионам')\n",
    "handles.append(h_trend)\n",
